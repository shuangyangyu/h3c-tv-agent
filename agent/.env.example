# H3C switch
H3C_HOST=192.168.1.254
H3C_PORT=23
H3C_USER=hass_robot
H3C_PASSWORD=
H3C_ACL_ID=3000

# MQTT (HA Mosquitto addon, usually exposed on HA host)
MQTT_HOST=192.168.1.249
MQTT_PORT=1883
MQTT_USER=homeassistant
MQTT_PASSWORD=
MQTT_PREFIX=h3c/tv
MQTT_CLIENT_ID=h3c-tv-agent

LOG_LEVEL=INFO
POLL_INTERVAL_SEC=0
FEEDBACK_MODE=h3c_syslog
# 进程内 UDP syslog（单容器 / 将来 addon）；0=关闭
SYSLOG_UDP_PORT=514
# 可选文件 tail，一般留空
# H3C_SYSLOG_PATH=
