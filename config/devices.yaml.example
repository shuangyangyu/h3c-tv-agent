# 设备身份：key（建议直接中文名）+ ip；mac / name 可省略
# access / policy_route：引用上面的 key

devices:
  - key: 主卧电视
    ip: 192.168.1.24
  - key: 客厅电视
    ip: 192.168.1.25
  - key: 老人房电视
    ip: 192.168.1.26
  - key: 书房电视
    ip: 192.168.1.27
  - key: 测试手机
    ip: 192.168.1.36

# 网络通断 → ACL 3000 + MQTT h3c/tv
access:
  - 主卧电视
  - 客厅电视
  - 老人房电视
  - 书房电视

# 策略路由 → ACL 3001 + MQTT h3c/route
policy_route:
  - 测试手机
