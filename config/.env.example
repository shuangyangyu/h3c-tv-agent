# === config/.env：连接、密钥、行为（含 slog）===
# 与 devices.yaml 同目录；复制本文件为 .env 后填写密码
H3C_HOST=192.168.1.254
H3C_PORT=23
H3C_USER=hass_robot
H3C_PASSWORD=
H3C_ACL_ID=3000

# 通断规则递加（与现网 permit 10/20/… deny 15/25/… 对齐）
ACCESS_PERMIT_RULE_BASE=10
ACCESS_PERMIT_RULE_STEP=10
ACCESS_DENY_RULE_BASE=15
ACCESS_DENY_RULE_STEP=10

# 策略路由：3001 源 permit → mihomo；3002 私网目的 + PBR deny node → 普通路由
ROUTE_ACL_ID=3001
ROUTE_BYPASS_ACL_ID=3002
ROUTE_RULE_BASE=100
ROUTE_RULE_STEP=10
ROUTE_BYPASS_CIDRS=192.168.0.0/16,10.0.0.0/8
PBR_NAME=mihomo
PBR_DENY_NODE=5
ACL_APPLY_INTERFACES=Vlan-interface1

MQTT_HOST=192.168.1.249
MQTT_PORT=1883
MQTT_USER=homeassistant
MQTT_PASSWORD=
MQTT_PREFIX=h3c/tv
MQTT_ROUTE_PREFIX=h3c/route
MQTT_CLIENT_ID=h3c-tv-agent

# slog / structlog
LOG_LEVEL=INFO
LOG_FORMAT=json

POLL_INTERVAL_SEC=0
FEEDBACK_MODE=h3c_syslog
SYSLOG_UDP_PORT=514

# 设备清单由 compose 挂载 config/devices.yaml → /app/devices.yaml
DEVICES_CONFIG_PATH=/app/devices.yaml

# === HA 儿童管理一键安装（MQTT Discovery 按钮）===
# 配置后 Agent 会发现 button.h3c_install_child；按下即 SSH 部署集成+卡片并重启 HA
HA_SSH_HOST=192.168.1.249
HA_SSH_PORT=22
HA_SSH_USER=root
HA_SSH_PASSWORD=
HA_CUSTOM_COMPONENTS=/config/custom_components
HA_RESTART_AFTER_INSTALL=true
HASS_PACKAGE_PATH=/app/hass/h3c_tv_child

# 调试专用
# H3C_SYSLOG_PATH=
